<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rcstudio_whatsapp_coexistence.Inbox">
        <div class="o_rcs_wa_inbox d-flex h-100 w-100 overflow-hidden">
            <ConversationList/>
            <div class="o_rcs_wa_main flex-grow-1 d-flex flex-column overflow-hidden">
                <Thread t-if="store.activeId"/>
                <div t-else="" class="o_rcs_wa_empty d-flex flex-column align-items-center justify-content-center h-100 text-center px-4">
                    <i class="fa fa-whatsapp o_rcs_wa_empty_icon"/>
                    <p t-if="store.conversations.length" class="mt-3 mb-0 opacity-75">Pick a conversation to start replying.</p>
                    <p t-else="" class="mt-3 mb-0 opacity-75">Conversations appear here as soon as a customer writes to one of your business numbers.</p>
                </div>
            </div>
        </div>
    </t>
</templates>
