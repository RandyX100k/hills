<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="after">
            <button t-if="rcsWaVisible" class="o-mail-Chatter-rcsWa btn btn-secondary text-nowrap me-1"
                    t-att-class="{ 'my-2': !props.compactHeight }" t-on-click="onClickRcsWa" title="Send a WhatsApp template from this record">
                <i class="fa fa-whatsapp me-1"/>WhatsApp
            </button>
        </xpath>
    </t>
</templates>
