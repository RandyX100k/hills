<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.PhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]" position="inside">
            <a t-if="rcsWaVisible" href="#" class="o_rcs_wa_phone_link ms-2 d-inline-flex align-items-center"
               title="Send by WhatsApp" t-on-click="onClickRcsWa">
                <i class="fa fa-whatsapp"/>
            </a>
        </xpath>
    </t>
    <t t-inherit="web.FormPhoneField" t-inherit-mode="extension">
        <xpath expr="//a[hasclass('o_phone_form_link')]" position="after">
            <a t-if="rcsWaVisible" href="#" class="o_rcs_wa_phone_link ms-3 d-inline-flex align-items-center"
               title="Send by WhatsApp" t-on-click="onClickRcsWa">
                <i class="fa fa-whatsapp"/><small class="fw-bold ms-1">WhatsApp</small>
            </a>
        </xpath>
    </t>
</templates>
