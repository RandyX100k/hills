<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- 18.0: no res.groups.privilege; groups hang from an ir.module.category -->
    <record id="module_category_whatsapp" model="ir.module.category">
        <field name="name">WhatsApp</field>
        <field name="parent_id" ref="base.module_category_productivity"/>
        <field name="sequence">40</field>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">Operator</field>
        <!-- 18.0: res.groups has no sequence field -->
        <field name="category_id" ref="module_category_whatsapp"/>
        <field name="comment">Answers conversations from the inbox and sends templates from records, on the business numbers they are assigned to.</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Connects business numbers, manages templates and settings, and sees every conversation.</field>
    </record>

</odoo>
