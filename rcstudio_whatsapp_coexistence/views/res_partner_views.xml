<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.form.rcs.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_rcs_whatsapp_conversations" type="object" class="oe_stat_button"
                        icon="fa-whatsapp" groups="rcstudio_whatsapp_coexistence.group_user"
                        invisible="rcs_whatsapp_conversation_count == 0">
                    <field name="rcs_whatsapp_conversation_count" widget="statinfo" string="WhatsApp"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
