<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_server_action_form_whatsapp" model="ir.ui.view">
        <field name="name">ir.actions.server.form.rcs.whatsapp</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">
            <!-- 18.0: the base form wraps the action fields in <group name="action_content"> (19.0: <t>) -->
            <xpath expr="//group[@name='action_content']" position="after">
                <group invisible="state != 'rcs_whatsapp'" name="rcs_whatsapp">
                    <field name="rcs_whatsapp_template_id" required="state == 'rcs_whatsapp'"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
