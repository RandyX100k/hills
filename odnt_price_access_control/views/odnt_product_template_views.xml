<odoo>
    <!-- Product Template – Form View -->
    <record id="odnt_view_product_template_form_price" model="ir.ui.view">
        <field name="name">odnt.product.template.form.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <field name="odnt_price_editable" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="readonly">not odnt_price_editable</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="readonly">not odnt_price_editable</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

        </field>
    </record>

    <!-- Product Template – List View -->
    <record id="odnt_view_product_template_list_price" model="ir.ui.view">
        <field name="name">odnt.product.template.list.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">

            <xpath expr="//list" position="inside">
                <field name="odnt_price_editable" column_invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="readonly">not odnt_price_editable</attribute>
            </xpath>

        </field>
    </record>

    <!-- Product Template – Kanban View -->
    <record id="odnt_view_product_template_kanban_price" model="ir.ui.view">
        <field name="name">odnt.product.template.kanban.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="odnt_price_editable"/>
            </xpath>
        </field>
    </record>
</odoo>
