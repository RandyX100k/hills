<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_inventory_import_wizard_form" model="ir.ui.view">
        <field name="name">product.inventory.import.wizard.form</field>
        <field name="model">product.inventory.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar productos">
                <p class="text-muted">
                    Sube un Excel con las columnas "Nombre en pantalla" (o "Nombre"),
                    "Costo promedio", "Precio de venta" y "Cantidad a la mano". Si el
                    producto ya existe (mismo nombre exacto) se actualiza el costo, el
                    precio de venta y la existencia (se deja igual a la cantidad del
                    Excel); si estaba configurado como Servicio se corrige a Bienes
                    para poder llevar inventario. Si no existe se crea como Bienes con
                    inventario rastreado y se carga la existencia inicial. En todos los
                    casos la política de facturación queda en "Cantidades ordenadas" y,
                    si eliges un impuesto abajo, se aplica igual en compras y ventas.
                </p>
                <group>
                    <field name="file_data" filename="filename" />
                    <field name="filename" invisible="1" />
                    <field name="tax_id" />
                    <field name="result" readonly="1" nolabel="1"
                        placeholder="El resultado aparecerá aquí después de importar." />
                </group>
                <footer>
                    <button name="action_simulate" string="Simular importación" type="object"
                        class="btn-secondary" />
                    <button name="action_import" string="Importar" type="object"
                        class="btn-primary" />
                    <button string="Cerrar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_inventory_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar productos</field>
        <field name="res_model">product.inventory.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_product_inventory_import_wizard"
        name="Importar productos"
        parent="stock.menu_stock_root"
        action="action_product_inventory_import_wizard"
        sequence="95" />

</odoo>
